<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>


<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="sea.gui.GameResultController">
   <children>
      <Button layoutX="276.0" layoutY="360.0" mnemonicParsing="false" onAction="#clickFetch" text="Refresh" />
      <TableView fx:id="tableResults" prefHeight="353.0" prefWidth="600.0">
        <columns>
          <TableColumn fx:id="colId" prefWidth="75.0" text="Id" />
          <TableColumn fx:id="colPX" prefWidth="75.0" text="PlayerX" />
            <TableColumn fx:id="colPO" prefWidth="75.0" text="PlayerO" />
            <TableColumn fx:id="colWin" prefWidth="75.0" text="Winner" />
        </columns>
      </TableView>
   </children>
</AnchorPane>
